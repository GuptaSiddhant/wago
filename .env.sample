# ===== WaGo — environment configuration (copy to .env and fill in) =====

# PocketBase superuser used to seed admin access on first boot.
ADMIN_EMAIL=admin@wago.local
ADMIN_PASSWORD=

# WhatsApp Cloud API webhook verification.
# Used for the GET /api/wa/webhook handshake and to verify inbound signatures.
WA_WEBHOOK_VERIFY_TOKEN=
# Meta App Secret (for X-Hub-Signature-256 validation of inbound messages).
# Optional; when empty, inbound payloads are not signature-checked.
META_APP_SECRET=

# --- SMTP (notification emails) ---
# When SMTP_HOST is set, PocketBase's SMTP mailer is enabled at startup and
# emails are sent for notification events (e.g. new chat when an agent is away).
# Leave SMTP_HOST empty to disable email notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Enable implicit TLS for SMTP submission (port 465 typically).
SMTP_TLS=false
# From-address/name used on outgoing emails (defaults to ADMIN_EMAIL / "WaGo").
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=WaGo

# --- WhatsApp notifications (best-effort) ---
# An approved Meta template name used to send WhatsApp notifications to
# agents who are away and have a phone number set on their user profile.
# Optional; when empty, WhatsApp notifications are disabled.
WA_NOTIFICATION_TEMPLATE=
